# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Naver Developers > Application > Search API (Local search). Server only.
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=


# Naver Cloud Platform > CLOVA OCR (Receipt domain). Optional: when unset,
# every receipt goes to the manual approval queue.
CLOVA_OCR_INVOKE_URL=
CLOVA_OCR_SECRET=

# Public site origin, used for OAuth redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000
